# ---------------------------------------------------------------------------
# hiver-support-agent — environment template
# Copy to .env and fill in. Every var here is validated at startup by
# src/config/env.js — the app throws immediately if a required var is missing.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Groq API key — the sole LLM provider. Get one at https://console.groq.com/keys
# (Groq replaced Gemini mid-project: Gemini's free tier is 500 req/day, too low
# for a 200-row eval with replies + judge; Groq's is much higher-throughput.)
GROQ_API_KEY=your-groq-api-key

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/hiver_support

# --- Optional (defaults shown) ---------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Model used for classifier / responder / escalation / judge.
# openai/gpt-oss-20b: fast, free tier, high rate limit (Groq default).
# NOTE: llama-3.3-70b-versatile is documented by Groq but was not available on
# the account used for the eval (models.list() had no Llama-3.3 variants).
GROQ_MODEL=openai/gpt-oss-20b
# Hard cap on output tokens for every model call. 2048 because gpt-oss models
# bill reasoning tokens against this cap before the JSON answer starts.
LLM_MAX_TOKENS=2048
# Minimum spacing between provider calls, in ms. 0 = unlimited.
# Set ~4000 for a 15/min budget before long eval runs.
LLM_MIN_INTERVAL_MS=0

# Kaggle credentials — OPTIONAL. Set both to let `npm run seed` download
# data/raw/twcs.csv automatically (Kaggle → Account → Create New API Token).
# Set neither if you already have the CSV locally; setting only one is an error.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Rate limiting on public routes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Seeding: stop after N accepted Amazon threads (0 = no limit, full dataset)
# A subsample of 5000 is plenty for this assignment and seeds in ~2 minutes.
SEED_MAX_THREADS=5000

# Evaluation: how many golden-set rows get the LLM-as-judge rubric
EVAL_JUDGE_SAMPLE_SIZE=30
